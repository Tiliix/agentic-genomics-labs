# ---------------------------------------------------------------------------
# Azure OpenAI configuration for the cell-type annotation agent.
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `src/annotate_agent.py` loads these via python-dotenv.
# Do NOT commit your real .env (it is covered by .gitignore patterns).
# ---------------------------------------------------------------------------

# Base endpoint of your Azure OpenAI resource (no trailing path).
# Example (classic Azure OpenAI): https://my-aoai-resource.openai.azure.com/
# Example (Azure AI Foundry v1):  https://my-resource.services.ai.azure.com/openai/v1
# The agent auto-detects the Foundry "/openai/v1" style and uses the
# OpenAI-compatible client; the classic style uses the AzureOpenAI client.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/

# The *deployment name* you created for a chat model (e.g. gpt-4o, gpt-4o-mini,
# gpt-5.1). This is the deployment name, NOT the underlying model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure OpenAI REST API version (data-plane). Classic endpoints only; ignored
# for the Azure AI Foundry "/openai/v1" endpoint style.
AZURE_OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------------------
# Authentication — choose ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A: API key auth (simplest for a lab). Leave blank to use Entra ID.
AZURE_OPENAI_API_KEY=

# Option B: Keyless auth via Microsoft Entra ID (DefaultAzureCredential).
# Set this to "true" to ignore the key above and use `az login` / managed identity.
# Requires the "Cognitive Services OpenAI User" role on the resource. The agent
# selects the correct token scope automatically (cognitiveservices.azure.com for
# classic endpoints, ai.azure.com for the Azure AI Foundry "/openai/v1" style).
USE_AZURE_AD_AUTH=false
